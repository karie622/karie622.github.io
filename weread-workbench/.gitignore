# 个人明文数据：不进入公开仓库（隐私保护）
data/*.json
weread_api_key

# 加密的离线数据包：可进入仓库（无密钥无法解密，等同隐私保护）
# 例外已在下方放行
!data/*.enc

# 分组映射（仅 bookId→分组名，无私密笔记内容）在线/离线模式均需，放行明文
!data/book_groups.json
# 书架缓存快照（仅 bookId/title/author/deepLink，无笔记内容）作为离线回退数据源，放行明文
!data/shelf.json

# 运行/缓存
__pycache__/
*.pyc
*.pyo
*.log
.DS_Store
Thumbs.db
